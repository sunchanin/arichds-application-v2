            ],
            [
              "***ถ้าสามารถทำให้ หน้า billing แบบไม่ต้องเปิดหน้านี้ใว้ตลอดและ cap จากหลังบ้านก็ได้นะ โดยหน้า cap เป็นแบบที่ตกลงกันล่าสุด หรือให้เห็นประมาณรูปนี้กก็ได้"
            ]
          ]
        },
        {
          "range": "AF17:AF18",
          "rows": 2,
          "cols": 1,
          "cells": 2,
